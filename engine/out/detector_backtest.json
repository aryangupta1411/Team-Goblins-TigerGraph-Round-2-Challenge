      "proposal_id": "AUTO-DET-02",
      "name": "Multi-day sub-$6 micro-charge wave",
      "discovered_by": "amount_band_cluster(product_cd='C', amt=[1,6], min_txns=4, min_days=4)",
      "synthesized_sql": "WITH micro AS ( SELECT TransactionID, id, card_id, ts, amt, addr1, has_identity FROM txc WHERE ts >= '2016-07-01' AND product_cd = 'C' AND channel = 'online' AND amt BETWEEN 1.00 AND 6.00 AND card_id NOT IN (SELECT DISTINCT card_id FROM txc WHERE product_cd = 'C' AND amt < 10.0 AND ts < '2016-07-01') ), card_stats AS ( SELECT card_id FROM micro GROUP BY 1 HAVING count(*) BETWEEN 4 AND 6 AND count(DISTINCT ts::DATE) >= 4 AND count(*) FILTER (WHERE addr1 != '' OR has_identity) >= 3 ) SELECT m.id, m.card_id, m.ts::VARCHAR, m.amt FROM micro m JOIN card_stats s USING (card_id) ORDER BY m.ts, m.TransactionID",
