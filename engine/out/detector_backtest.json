    {
      "proposal_id": "AUTO-DET-04",
      "name": "Dormant-wake climbing drain",
      "discovered_by": "sequence_scan(product_cd='C', no identity, quiet>=21d, min_len=5, max>=1100)",
      "synthesized_sql": "WITH cand AS ( SELECT TransactionID, id, card_id, ts, amt FROM txc WHERE ts >= '2016-07-01' AND product_cd = 'C' AND channel = 'online' AND NOT has_identity AND amt >= 70.0 ), runs AS ( SELECT card_id, min(ts) AS first_ts FROM cand GROUP BY 1 HAVING count(*) >= 5 AND max(amt) >= 1100.0 AND min(amt) < 300.0 ), woke AS ( SELECT r.card_id FROM runs r LEFT JOIN txc p ON p.card_id = r.card_id AND p.ts < r.first_ts GROUP BY r.card_id, r.first_ts HAVING max(p.ts) IS NULL OR r.first_ts - max(p.ts) >= INTERVAL 21 DAY ) SELECT c.id, c.card_id, c.ts::VARCHAR, c.amt FROM cand c JOIN woke w USING (card_id) ORDER BY c.ts, c.TransactionID",
