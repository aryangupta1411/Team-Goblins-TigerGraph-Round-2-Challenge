      "proposal_id": "AUTO-DET-03",
      "name": "New-mobile anonymous-proxy burst wave",
      "discovered_by": "telemetry_scan(device_type='mobile', proxy='IP_PROXY:ANONYMOUS', device_new='New', min_amt=200)",
      "synthesized_sql": "WITH cand AS ( SELECT TransactionID, id, card_id, ts, amt, device_id FROM txc WHERE ts >= '2016-07-01' AND product_cd = 'C' AND channel = 'online' AND device_type = 'mobile' AND device_new = 'New' AND proxy = 'IP_PROXY:ANONYMOUS' AND amt >= 200.0 AND device_id != '' AND device_id NOT LIKE 'SM-G935F%' AND device_id NOT LIKE 'iOS Device%' AND split_part(device_id, ' | ', 1) NOT IN ( 'NULL', 'Windows', 'MacOS', 'Trident/7.0', 'rv:11.0', 'rv:52.0', 'Blade V6 Plus Build/MRA58K' ) ), wave_cards AS (SELECT card_id FROM cand GROUP BY 1 HAVING count(*) >= 2) SELECT c.id, c.card_id, c.ts::VARCHAR, c.amt, c.device_id FROM cand c JOIN wave_cards w USING (card_id) ORDER BY c.ts, c.TransactionID",
