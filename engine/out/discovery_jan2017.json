    "synthesized_sql": "WITH seq AS (SELECT *, lag(amt) OVER w AS prev_amt, date_diff('second', lag(ts) OVER w, ts) / 86400.0 AS gap_d,\n                            date_diff('second', lag(ts) OVER a, ts) / 86400.0 AS same_amt_gap_d\n                     FROM txc WINDOW w AS (PARTITION BY card_id, product_cd, channel ORDER BY ts, TransactionID),\n                                     a AS (PARTITION BY card_id, round(amt, 2) ORDER BY ts, TransactionID)) SELECT id, card_id, ts::VARCHAR, amt FROM seq WHERE ts >= '2016-07-01' AND (CASE WHEN same_amt_gap_d BETWEEN 6.9 AND 7.1 THEN 'weekly_same_amount'\n                   WHEN same_amt_gap_d BETWEEN 27 AND 32 THEN 'monthly_same_amount' ELSE '' END)::VARCHAR = 'weekly_same_amount' AND (strftime(ts, '%a %H'))::VARCHAR = 'Wed 09' ORDER BY ts, TransactionID",
