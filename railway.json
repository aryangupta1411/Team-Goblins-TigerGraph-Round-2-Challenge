{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/Dockerfile",
      "/.dockerignore",
      "/railway.json",
      "/requirements-ui.txt",
      "/.streamlit/**",
      "/ui/**",
      "/ops/**",
      "/rag/**",
      "/cases/**",
      "/runs/live-final-2/**",
      "/agent/__init__.py",
      "/agent/security.py",
      "/schema_engine/__init__.py",
      "/schema_engine/attestation.py",
      "/engine/out/detector_backtest.json",
      "/engine/out/containment_summary.json",
      "/engine/out/proof_snapshot.json",
      "/runs/r2-final/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/_stcore/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
