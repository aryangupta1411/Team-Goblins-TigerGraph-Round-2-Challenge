{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/Dockerfile",
      "/.dockerignore",
      "/railway.json",
      "/requirements-live.txt",
      "/.streamlit/**",
      "/agent/**",
      "/engine/**",
      "/etl/**",
      "/graph/**",
      "/mcp/**",
      "/ops/**",
      "/policy/**",
      "/rag/**",
      "/schema_engine/**",
      "/contracts/**",
      "/data/**",
      "/cases/**",
      "/ui/**",
      "/runs/hhf-final/**",
      "/runs/live-final-2/**",
      "/runs/hhf-final-2/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/_stcore/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
